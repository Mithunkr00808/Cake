rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if the user has the Admin Custom Claim
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Publicly readable, but only writable by admin
    match /products/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /settings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Users can only read/write their own data, admin can read/write all
    match /users/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    // Orders: users can read their own, admin has full access. Creation is handled securely via Server Actions (Admin SDK).
    match /orders/{orderId} {
      allow create: if false; // Block client-side creation
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // Contact messages: anyone can write, only admin can read
    match /contacts/{document=**} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
  }
}
