rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'sliceofcake2026@gmail.com';
    }
    
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // 1. ORDERS Collection
    match /orders/{orderId} {
      // Order creation is handled securely via Server Actions (Admin SDK). Block client-side creation.
      allow create: if false;
      // Admins can read/update all orders. Users can read their own.
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == resource.data.userId);
      allow update, delete: if isAdmin();
    }

    // 2. USERS Collection
    match /users/{userId} {
      // Users can read/write their own profile data, admins can read/write all
      allow read, write: if isOwner(userId) || isAdmin();
    }
    
    // 3. PRODUCTS Collection (Inventory)
    match /products/{productId} {
      // Anyone can view products
      allow read: if true;
      // Only admins can add/edit/delete products
      allow write: if isAdmin();
    }

    // 4. STORE Collection (Store Settings like Pincodes, About Us)
    match /store/{document=**} {
      // Anyone can read store settings
      allow read: if true;
      // Only admins can edit store settings
      allow write: if isAdmin();
    }
  }
}
